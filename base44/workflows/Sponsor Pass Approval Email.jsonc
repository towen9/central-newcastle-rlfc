{
  "name": "Sponsor Pass Approval Email",
  "description": "",
  "trigger": {
    "condition": "${ ((.trigger.data.tier_name == \"Sponsor Season Pass\") and (.trigger.data.status == \"active\") and (.trigger.old_data.status != \"active\")) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Membership"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "sponsor_pass_approval_email",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sendSponsorApprovalEmail",
            "args": {
              "membership_id": "{{event.entity_id}}"
            }
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "sendSponsorApprovalEmail"
  }
}